{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Northstar",
  "mainBinaryName": "Northstar",
  "version": "1.0.0",
  "identifier": "io.pureportal.northstar",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Northstar HQ",
        "width": 1280,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost https: wss:",
        "font-src": "'self'",
        "img-src": "'self' asset: http://asset.localhost data: blob: https:",
        "media-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'self'",
        "frame-ancestors": "'none'",
        "style-src": "'self' 'unsafe-inline'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "PurePortal",
    "homepage": "https://github.com/pureportal/work-hard-play-hard",
    "category": "Productivity",
    "shortDescription": "Virtual office for distributed teams.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 24
    }
  }
}
