{
  "name": "@workhard/client",
  "private": true,
  "version": "8.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/check-optimized-images.mjs && tsc -b && vite build",
    "build:native": "node scripts/check-optimized-images.mjs && tsc -b && vite build --outDir dist-native && node scripts/prepare-native-assets.mjs",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "android:init": "tauri android init --ci --skip-targets-install && node scripts/configure-android.mjs",
    "android:dev": "tauri android dev",
    "android:build": "tauri android build --apk --target aarch64 armv7 x86_64 --ci",
    "android:sign": "node scripts/sign-android-apk.mjs",
    "android:release": "pnpm android:build && pnpm android:sign"
  },
  "dependencies": {
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@workhard/shared": "workspace:*",
    "lucide-react": "^0.542.0",
    "pixi.js": "^8.20.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-joyride": "^3.2.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^6.0.0",
    "jsdom": "^26.1.0",
    "typescript": "^5.9.2",
    "vite": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
